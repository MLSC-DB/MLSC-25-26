<!DOCTYPE html>
<html class="dark" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              primary: "#0b73da",
              "background-light": "#f5f7f8",
              "background-dark": "#101922",
            },
            fontFamily: {
              display: ["Space Grotesk", "sans-serif"],
            },
            borderRadius: {
              DEFAULT: "0.25rem",
              lg: "0.5rem",
              xl: "0.75rem",
              full: "9999px",
            },
          },
        },
      };
    </script>
  </head>

  <body class="font-display bg-background-dark text-gray-200">
    <div class="relative flex min-h-screen w-full flex-col items-center justify-start bg-background-dark p-6 overflow-hidden">
      <div class="absolute -top-1/4 -left-1/4 h-96 w-96 rounded-full bg-primary/20 blur-3xl animate-pulse" style="animation-duration: 5s;"></div>
      <div class="absolute -bottom-1/4 -right-1/4 h-96 w-96 rounded-full bg-primary/20 blur-3xl animate-pulse" style="animation-duration: 5s; animation-delay: 2.5s;"></div>

      <div class="relative z-10 w-full max-w-7xl rounded-xl border border-white/10 bg-[#111418]/60 p-8 backdrop-blur-sm mt-6">
        <div class="flex items-center justify-between mb-6">
          <div class="flex items-center gap-4">
            <div class="relative h-12 w-12">
              <div class="absolute inset-0 rounded-full bg-primary opacity-30 blur-lg animate-pulse"></div>
              <div class="relative flex h-full w-full items-center justify-center rounded-full bg-[#283039]"><span class="material-symbols-outlined text-primary text-2xl">hub</span></div>
            </div>
            <div>
              <h1 class="text-2xl font-bold">📋 Registrations Dashboard</h1>
              <p class="text-sm text-[#9cabba]">Manage and export registration entries</p>
            </div>
          </div>

          <div class="flex items-center gap-4">
          <button id="testSheetsBtn" class="bg-yellow-500 text-black px-3 py-1 rounded hover:bg-yellow-600 text-sm">Test Sheets</button>
          <a href="/admin/logout" class="text-red-400 hover:underline">Logout</a>
          </div>
        </div>

        <form action="/admin/dashboard" method="GET" class="text-white mb-6 flex flex-wrap gap-4 items-center">
          <% const queryParams=[]; if (filters.year) queryParams.push(`year=${filters.year}`); if (filters.domain) queryParams.push(`domain=${filters.domain}`); if (filters.search) queryParams.push(`search=${filters.search}`);
             const queryString=queryParams.join("&"); %>

          <select name="year" class="bg-[#283039] text-white border border-white/10 px-3 py-2 text-sm rounded">
            <option value="">All Years</option>
            <option value="First Year" <%=filters.year==='First Year' ? 'selected' : '' %>>First Year</option>
            <option value="Second Year" <%=filters.year==='Second Year' ? 'selected' : '' %>>Second Year</option>
          </select>

          <select name="domain" class="bg-[#283039] text-white border border-white/10 px-3 py-2 text-sm rounded">
            <option value="">All Domains</option>
            <option value="Tech" <%=filters.domain==='Tech' ? 'selected' : '' %>>Tech</option>
            <option value="Design" <%=filters.domain==='Design' ? 'selected' : '' %>>Design</option>
            <option value="Management" <%=filters.domain==='Management' ? 'selected' : '' %>>Management</option>
          </select>

          <input type="text" name="search" placeholder="Search by name or email" value="<%= filters.search || '' %>" class="bg-[#283039] text-white border border-white/10 px-3 py-2 text-sm rounded" />

          <div class="flex items-center gap-2">
            <button type="submit" class="bg-primary text-white px-4 py-2 rounded">Filter</button>
            <a href="/admin/export?<%= queryString %>" class="bg-green-600 text-white px-3 py-2 text-sm rounded hover:bg-green-700">Export CSV</a>
          </div>
        </form>

        <div class="overflow-auto rounded shadow border border-white/10">
          <table class="min-w-full text-sm text-gray-200">
            <thead class="bg-[#0f1720] sticky top-0 z-10">
              <tr>
                <th class="py-3 px-4 text-left">#</th>
                <th class="py-3 px-4 text-left">Name</th>
                <th class="py-3 px-4 text-left">Email</th>
                <th class="py-3 px-4 text-left">Roll</th>
                <th class="py-3 px-4 text-left">Phone</th>
                <th class="py-3 px-4 text-left">Discord</th>
                <th class="py-3 px-4 text-left">Year</th>
                <th class="py-3 px-4 text-left">Team</th>
                <th class="py-3 px-4 text-left">Members</th>
                <th class="py-3 px-4 text-left">Domains</th>
                <th class="py-3 px-4 text-left">Join MLSC</th>
                <th class="py-3 px-4 text-left">Submitted At</th>
                <th class="py-3 px-4 text-left">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% entries.forEach((entry, index)=> { %>
              <tr class="<%= index % 2 === 0 ? 'bg-[#0b1114]' : 'bg-[#0f1417]' %> hover:bg-[#071018] transition-all">
                <td class="py-2 px-4 align-top"><%= index + 1 %></td>
                <td class="py-2 px-4 align-top"><%= entry.name %></td>
                <td class="py-2 px-4 align-top"><%= entry.email %></td>
                <td class="py-2 px-4 align-top"><%= entry.roll || '—' %></td>
                <td class="py-2 px-4 align-top"><%= entry.phone || '—' %></td>
                <td class="py-2 px-4 align-top"><%= entry.discord || '—' %></td>
                <td class="py-2 px-4 align-top"><%= entry.yearOfStudy || '—' %></td>
                <td class="py-2 px-4 align-top"><%= entry.teamName || '—' %></td>
                <td class="py-2 px-4 align-top">
                  <% /* Always show 4 member rows, blank for missing, 'NA' for blank preferences */ %>
                  <% for (let i = 0; i < 4; i++) { %>
                    <% const m = (entry.members && entry.members[i]) ? entry.members[i] : {name:'',email:'',roll:'',phone:'',discord:'',yearOfStudy:'',joinmlsc:'',preferences:{pref1:'NA',pref2:'NA',pref3:'NA'}}; %>
                    <div class="border-t border-white/5 pt-1 mt-1 text-sm">
                      <strong>Member <%= i+1 %>:</strong>
                      <div class="text-xs">Name: <%= m.name || '—' %></div>
                      <div class="text-xs">Email: <%= m.email || '—' %></div>
                      <div class="text-xs">Roll: <%= m.roll || '—' %></div>
                      <div class="text-xs">Phone: <%= m.phone || '—' %></div>
                      <div class="text-xs">Discord: <%= m.discord || '—' %></div>
                      <div class="text-xs">Year: <%= m.yearOfStudy || '—' %></div>
                      <div class="text-xs">Join MLSC: <%= m.joinmlsc || '—' %></div>
                      <div class="text-xs">Preferences: <%= m.preferences ? (m.preferences.pref1 || 'NA') : 'NA' %>, <%= m.preferences ? (m.preferences.pref2 || 'NA') : 'NA' %>, <%= m.preferences ? (m.preferences.pref3 || 'NA') : 'NA' %></div>
                    </div>
                  <% } %>
                </td>
                <td class="py-2 px-4 align-top">
                  <%= entry.domainPreference1 || '' %>
                  <% if (entry.domainPreference2) { %>, <%= entry.domainPreference2 %><% } %>
                  <% if (entry.domainPreference3) { %>, <%= entry.domainPreference3 %><% } %>
                </td>
                <td class="py-2 px-4 align-top"><%= entry.joinmlsc || '—' %></td>
                <td class="py-2 px-4 align-top"><%= entry.createdAt ? new Date(entry.createdAt).toLocaleString() : '—' %></td>
                <td class="py-2 px-4 align-top">
                  <form action="/admin/delete/<%= entry._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this entry?');">
                    <button type="submit" class="text-red-400 hover:underline">Delete</button>
                  </form>
                </td>
              </tr>
              <tr><td colspan="13" style="height:10px;background:#222;"></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Motivation Modal -->
  <div id="motivation-modal" class="fixed inset-0 bg-black bg-opacity-70 items-center justify-center hidden z-50">
        <div class="bg-[#111418] text-gray-200 max-w-lg w-full p-6 rounded shadow border border-white/5">
          <h2 class="text-xl font-semibold mb-4">Full Motivation</h2>
          <p id="modal-motivation-text" class="whitespace-pre-wrap"></p>
          <div class="text-right mt-4">
            <button onclick="closeMotivation()" class="bg-red-500 text-white px-4 py-1 rounded hover:bg-red-600">Close</button>
          </div>
        </div>
      </div>

    </div>

    <script>
      function showMotivation(text) {
        const modal = document.getElementById('motivation-modal');
        document.getElementById('modal-motivation-text').textContent = text;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }

      function closeMotivation() {
        const modal = document.getElementById('motivation-modal');
        modal.classList.remove('flex');
        modal.classList.add('hidden');
      }
      
      // Test Sheets button handler + toast
      function showToast(msg, success) {
        let t = document.getElementById('sheets-toast');
        if (!t) {
          t = document.createElement('div');
          t.id = 'sheets-toast';
          t.className = 'fixed bottom-6 right-6 bg-black/80 text-white px-4 py-2 rounded shadow';
          document.body.appendChild(t);
        }
        t.textContent = msg;
        t.style.backgroundColor = success ? 'rgba(16,185,129,0.95)' : 'rgba(220,38,38,0.95)';
        t.style.display = 'block';
        setTimeout(()=> t.style.display = 'none', 4000);
      }

      document.addEventListener('DOMContentLoaded', function(){
        const btn = document.getElementById('testSheetsBtn');
        if (!btn) return;
        btn.addEventListener('click', async function(){
          btn.disabled = true;
          btn.textContent = 'Testing...';
          try {
            const res = await fetch('/admin/test-sheet', { credentials: 'same-origin' });
            const json = await res.json();
            if (json && json.ok) {
              showToast('Sheets test succeeded', true);
            } else {
              showToast('Sheets test failed: ' + (json && json.error ? json.error : 'unknown'), false);
            }
          } catch (e) {
            showToast('Sheets test failed: ' + (e && e.message ? e.message : e), false);
          } finally {
            btn.disabled = false;
            btn.textContent = 'Test Sheets';
          }
        });
      });
    </script>
  </body>
</html>