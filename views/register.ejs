    <!-- Ensure browser spellcheck is disabled for all inputs/textareas on this page -->
    <script>
      (function(){
        function disableSpellcheck(root){
          try{
            var els = (root || document).querySelectorAll('input, textarea, select');
            els.forEach(function(el){
              try{ el.spellcheck = false; el.setAttribute('spellcheck','false'); }catch(e){}
            });
          }catch(e){}
        }

        // Run early and on DOMContentLoaded
        disableSpellcheck(document);
        document.addEventListener('DOMContentLoaded', function(){ disableSpellcheck(document); });

        // Observe additions to the form (in case scripts add elements later)
        if(window.MutationObserver){
          var obs = new MutationObserver(function(muts){
            muts.forEach(function(m){
              if(m.addedNodes && m.addedNodes.length){
                m.addedNodes.forEach(function(node){
                  if(node && node.querySelectorAll){ disableSpellcheck(node); }
                });
              }
            });
          });
          obs.observe(document.documentElement || document.body, { childList:true, subtree:true });
        }
      })();
    </script>

    <!-- Register page script (public) -->
    <script src="/js/register-main.js"></script>
  </body>
