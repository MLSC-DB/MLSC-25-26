<!-- Preloader Style & Base Styles -->
<style>
  @keyframes move-xp {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(600%);
    }
  }

  .loader-track {
    animation: move-xp 3s linear infinite;
  }

  .bar-rect {
    width: 16px;
    height: 100%;
    background-color: skyblue;
    margin-right: 2px;
  }

  .xp-btn {
    font-family: Tahoma, sans-serif;
    font-size: 12px;
    font-weight: bold;
    padding: 2px 8px;
    color: black;
    background: linear-gradient(to bottom, #dbeeff, #7fbfff);
    border: 1px solid #3a6ea5;
    border-radius: 4px;
    box-shadow: inset 0 0 0 1px #ffffffa1, inset 0 1px 0 0 #ffffffa1;
    white-space: nowrap;
    margin-right: 2px;
    transition: background 0.2s ease-in-out;
  }

  .xp-btn:hover {
    background: linear-gradient(to bottom, #c5e3ff, #66b2ff);
  }

  .xp-btn:active,
  .xp-btn.active {
    background: linear-gradient(to bottom, #7fbfff, #dbeeff);
    box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.4);
  }

  .xp-taskbar-btn {
    font-family: Tahoma, sans-serif;
    box-shadow: inset 1px 1px white, inset -1px -1px #888;
  }

  .taskbar-btn {
    border-width: 1px;
    border-color: #808080;
    background: linear-gradient(to bottom, #d4d0c8, #b5b5b5);
    box-shadow: inset 1px 1px #fff, inset -1px -1px #808080;
  }

  .taskbar-btn:hover {
    box-shadow: 0 0 4px rgba(0, 0, 0, 0.5);
  }

  .taskbar-btn.active-task {
    background: linear-gradient(to bottom, #c0c0c0, #a0a0a0);
    box-shadow: inset 1px 1px #ffffff, inset -1px -1px #808080;
  }

  .image-render-pixelated {
    image-rendering: pixelated;
  }

  html,
  body.lock-scroll {
    overflow: clip !important;
    height: 100vh !important;
    overscroll-behavior: none !important; /* prevent background bounce while a popup is open */
  }

  html,
  body {
    max-height: 100vh;
    overflow-x: hidden;
  }

  /* Prevent scroll chaining (overscroll) from popup content to the page */
  .popup {
    overscroll-behavior: contain;
    background-color: #0b1020; /* deep dark base to avoid gray flashes behind content */
  }
  .popup .header {
    overscroll-behavior: contain;
  }
  .popup .content {
    overscroll-behavior: contain;
    background-color: #0b1020; /* ensure content area is opaque */
  }

  /* Skeleton shimmer for popup content while loading */
  @keyframes skeleton-shimmer {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  .skeleton {
    position: relative;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.08);
  }
  .skeleton::after {
    content: "";
    position: absolute;
    inset: 0;
    transform: translateX(-100%);
    background-image: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.2) 50%,
      rgba(255, 255, 255, 0) 100%
    );
    animation: skeleton-shimmer 1.4s infinite;
  }

  /* Thin indeterminate bar under the window header while loading */
  @keyframes header-indeterminate {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }
  .popup-loading .header {
    position: relative;
  }
  .popup-loading .header::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background-image: linear-gradient(
      90deg,
      transparent,
      #93c5fd,
      #60a5fa,
      #93c5fd,
      transparent
    );
    background-size: 200% 100%;
    animation: header-indeterminate 1.2s linear infinite;
    opacity: 0.9;
  }
</style>

