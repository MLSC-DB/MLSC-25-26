<!-- Tailwind config MUST be defined before the CDN script -->
<script>
  window.tailwind = window.tailwind || {};
  window.tailwind.config = {
    theme: { extend: {} },
    safelist: [
      // Background + responsive bg size used on <body>
      "bg-[url(/images/bg.jpg)]",
      "bg-[auto_650px]",
      "sm:bg-[auto_1300px]",

      // Popup window container (created dynamically)
      "fixed",
      "bg-slate-600",
      "border-2",
      "border-slate-100",
      "transition-all",
      "duration-300",
      "scale-95",
      "opacity-0",
      "w-[300px]",
      "h-[400px]",
      "sm:w-[600px]",
      "sm:h-[400px]",

      // Popup header + controls
      "flex",
      "justify-between",
      "items-center",
      "px-1",
      "py-1",
      "bg-slate-100",
      "cursor-move",
      "select-none",
      "gap-1",
      "w-6",
      "h-6",
      "bg-slate-400",
      "hover:bg-slate-700",
      "text-sm",
      "font-bold",
      "border",

      // Popup content area
      "w-full",
      "h-[calc(100%-2.5rem)]",
      "overflow-auto",
      "text-white",
      "p-2",

      // Taskbar button created at runtime
      "items-center",
      "gap-2",
      "text-black",
      "px-3",
      "py-1",
      "font-mono",
      "border",
      "border-[#808080]",
      "bg-gradient-to-b",
      "from-[#d4d0c8]",
      "to-[#b5b5b5]",
      "shadow-inner",
      "hover:brightness-90",
      "brightness-90",
      "active:translate-y-[1px]",
      "translate-y-[1px]",
      "h-10",
      "rounded-sm",
      "w-10",
      "h-10",

      // Common toggled states via JS
      "hidden",
      "opacity-100",
      "scale-100",
      "scale-0",
      "pointer-events-none",

      // Misc content placeholders
      "text-center",
      "mt-16",
    ],
  };
  // Optional debug helper – returns true when Tailwind utilities are active
  window.__checkTailwind = function () {
    try {
      const probe = document.createElement("div");
      probe.className = "flex";
      document.head.appendChild(probe);
      const ok = getComputedStyle(probe).display === "flex";
      document.head.removeChild(probe);
      return ok;
    } catch (_) {
      return false;
    }
  };
</script>
<!-- Tailwind CSS (pinned version) -->
<script src="https://cdn.tailwindcss.com/3.4.17"></script>

<link rel="icon" type="image/x-icon" href="/favicon.ico" />

<!-- Preloader Style & Base Styles -->
<style>
  @keyframes move-xp {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(600%);
    }
  }

  .loader-track {
    animation: move-xp 3s linear infinite;
  }

  .bar-rect {
    width: 16px;
    height: 100%;
    background-color: skyblue;
    margin-right: 2px;
  }

  .xp-btn {
    font-family: Tahoma, sans-serif;
    font-size: 12px;
    font-weight: bold;
    padding: 2px 8px;
    color: black;
    background: linear-gradient(to bottom, #dbeeff, #7fbfff);
    border: 1px solid #3a6ea5;
    border-radius: 4px;
    box-shadow: inset 0 0 0 1px #ffffffa1, inset 0 1px 0 0 #ffffffa1;
    white-space: nowrap;
    margin-right: 2px;
    transition: background 0.2s ease-in-out;
  }

  .xp-btn:hover {
    background: linear-gradient(to bottom, #c5e3ff, #66b2ff);
  }

  .xp-btn:active,
  .xp-btn.active {
    background: linear-gradient(to bottom, #7fbfff, #dbeeff);
    box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.4);
  }

  .xp-taskbar-btn {
    font-family: Tahoma, sans-serif;
    box-shadow: inset 1px 1px white, inset -1px -1px #888;
  }

  .taskbar-btn {
    border-width: 1px;
    border-color: #808080;
    background: linear-gradient(to bottom, #d4d0c8, #b5b5b5);
    box-shadow: inset 1px 1px #fff, inset -1px -1px #808080;
  }

  .taskbar-btn:hover {
    box-shadow: 0 0 4px rgba(0, 0, 0, 0.5);
  }

  .taskbar-btn.active-task {
    background: linear-gradient(to bottom, #c0c0c0, #a0a0a0);
    box-shadow: inset 1px 1px #ffffff, inset -1px -1px #808080;
  }

  .image-render-pixelated {
    image-rendering: pixelated;
  }

  html,
  body.lock-scroll {
    overflow: clip !important;
    height: 100vh !important;
  }

  html,
  body {
    max-height: 100vh;
    overflow-x: hidden;
  }
</style>

<!-- Minimal CSS fallback if Tailwind fails to load (debug safety net) -->
<script>
  (function () {
    function addFallbackCSS() {
      var css = [
        ".flex{display:flex}",
        ".justify-between{justify-content:space-between}",
        ".items-center{align-items:center}",
        ".px-1{padding-left:.25rem;padding-right:.25rem}",
        ".py-1{padding-top:.25rem;padding-bottom:.25rem}",
        ".px-4{padding-left:1rem;padding-right:1rem}",
        ".text-sm{font-size:.875rem;line-height:1.25rem}",
        ".font-mono{font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,'Liberation Mono','Courier New',monospace}",
        ".container{width:100%;max-width:1024px;margin-left:auto;margin-right:auto}",
        ".bg-slate-100{background-color:#f1f5f9}",
        ".bg-black{background-color:#000}",
      ].join("");
      var style = document.createElement("style");
      style.setAttribute("data-fallback", "tailwind-min");
      style.textContent = css;
      document.head.appendChild(style);
      console.warn(
        "Tailwind CDN seems unavailable; applied minimal CSS fallback."
      );
    }
    function check() {
      try {
        if (typeof window.__checkTailwind === "function") {
          if (!window.__checkTailwind()) addFallbackCSS();
        }
      } catch (e) {
        /* ignore */
      }
    }
    // Run ASAP
    if (document.readyState === "loading")
      document.addEventListener("DOMContentLoaded", check);
    else check();
  })();
</script>
