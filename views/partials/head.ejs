<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>MLSC DB</title>

<!-- LAST RESORT: Force all CSS inline -->
<style>
  /* Tailwind Reset */
  *,
  ::before,
  ::after {
    box-sizing: border-box;
    border-width: 0;
    border-style: solid;
    border-color: #e5e7eb;
  }
  ::before,
  ::after {
    --tw-content: "";
  }
  html {
    line-height: 1.5;
    -webkit-text-size-adjust: 100%;
    -moz-tab-size: 4;
    tab-size: 4;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif,
      "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol",
      "Noto Color Emoji";
    font-feature-settings: normal;
    font-variation-settings: normal;
  }
  body {
    margin: 0;
    line-height: inherit;
  }

  /* Essential Tailwind Classes for your homepage */
  .bg-black {
    background-color: rgb(0 0 0);
  }
  .bg-\[url\(\/images\/bg\.jpg\)\] {
    background-image: url(/images/bg.jpg);
  }
  .bg-\[auto_650px\] {
    background-size: auto 650px;
  }
  @media (min-width: 640px) {
    .sm\:bg-\[auto_1300px\] {
      background-size: auto 1300px;
    }
  }
  .container {
    width: 100%;
  }
  @media (min-width: 640px) {
    .container {
      max-width: 640px;
    }
  }
  @media (min-width: 768px) {
    .container {
      max-width: 768px;
    }
  }
  @media (min-width: 1024px) {
    .container {
      max-width: 1024px;
    }
  }
  @media (min-width: 1280px) {
    .container {
      max-width: 1280px;
    }
  }
  @media (min-width: 1536px) {
    .container {
      max-width: 1536px;
    }
  }
  .text-sm {
    font-size: 0.875rem;
    line-height: 1.25rem;
  }
  .font-mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      "Liberation Mono", "Courier New", monospace;
  }
  .px-4 {
    padding-left: 1rem;
    padding-right: 1rem;
  }
</style>

<!-- Backup CDN -->
<script src="https://cdn.tailwindcss.com"></script>

<link rel="icon" type="image/x-icon" href="/favicon.ico" />

<!-- Preloader Style & Base Styles -->
<style>
  @keyframes move-xp {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(600%);
    }
  }

  .loader-track {
    animation: move-xp 3s linear infinite;
  }

  .bar-rect {
    width: 16px;
    height: 100%;
    background-color: skyblue;
    margin-right: 2px;
  }

  .xp-btn {
    font-family: Tahoma, sans-serif;
    font-size: 12px;
    font-weight: bold;
    padding: 2px 8px;
    color: black;
    background: linear-gradient(to bottom, #dbeeff, #7fbfff);
    border: 1px solid #3a6ea5;
    border-radius: 4px;
    box-shadow: inset 0 0 0 1px #ffffffa1, inset 0 1px 0 0 #ffffffa1;
    white-space: nowrap;
    margin-right: 2px;
    transition: background 0.2s ease-in-out;
  }

  .xp-btn:hover {
    background: linear-gradient(to bottom, #c5e3ff, #66b2ff);
  }

  .xp-btn:active,
  .xp-btn.active {
    background: linear-gradient(to bottom, #7fbfff, #dbeeff);
    box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.4);
  }

  .xp-taskbar-btn {
    font-family: Tahoma, sans-serif;
    box-shadow: inset 1px 1px white, inset -1px -1px #888;
  }

  .taskbar-btn {
    border-width: 1px;
    border-color: #808080;
    background: linear-gradient(to bottom, #d4d0c8, #b5b5b5);
    box-shadow: inset 1px 1px #fff, inset -1px -1px #808080;
  }

  .taskbar-btn:hover {
    box-shadow: 0 0 4px rgba(0, 0, 0, 0.5);
  }

  .taskbar-btn.active-task {
    background: linear-gradient(to bottom, #c0c0c0, #a0a0a0);
    box-shadow: inset 1px 1px #ffffff, inset -1px -1px #808080;
  }

  .image-render-pixelated {
    image-rendering: pixelated;
  }

  html,
  body.lock-scroll {
    overflow: clip !important;
    height: 100vh !important;
  }

  html,
  body {
    max-height: 100vh;
    overflow-x: hidden;
  }
</style>
