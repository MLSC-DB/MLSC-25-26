<div
  id="notification"
  class="notification fixed left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 sm:absolute sm:left-auto sm:top-auto sm:translate-x-0 sm:translate-y-0 sm:right-5 sm:bottom-[70px] bg-yellow-50 rounded border-2 border-yellow-50 w-[min(92vw,380px)] h-[240px] sm:w-[400px] sm:h-[300px] opacity-100 scale-100 transition"
>
  <div
    class="notif-header w-full h-7 bg-blue-800 flex justify-between items-center"
  >
    <div
      class="mx-2 text-white font-semibold font-mono text-sm sm:text-base hover:cursor-default"
    >
      New Notification!
    </div>
    <button
      class="notif-close w-5 bg-gray-400 mx-1 border-1 hover:cursor-pointer hover:bg-gray-500 drop-shadow-sm font-bold text-sm"
    >
      X
    </button>
  </div>
  <div
    class="notif-content flex justify-between items-center w-full h-32 mt-3 sm:mt-[60px]"
  >
    <div>
      <img
        src="/images/ibutton.png"
        alt="i_button"
        class="w-[200px] h-[175px]"
      />
    </div>
    <div
      class="notif-message flex justify-between items-center mx-2 sm:h-full w-64 font-mono text-sm sm:text-sm hover:cursor-default"
    >
      The registrations for MLSC have begun! Click on the button below or the
      'Registrations' icon on your desktop to be a part of our society.
    </div>
  </div>
  <a
    href="/register"
    role="button"
    aria-label="Open Register Page"
    class="register-button flex items-center justify-center w-36 h-9 sm:w-32 sm:h-8 mt-4 sm:mt-7 bg-gray-400 mx-auto text-base sm:text-sm hover:cursor-pointer hover:bg-gray-500 font-mono drop-shadow-md border-2 text-center no-underline text-black"
  >
    Register
  </a>
</div>
