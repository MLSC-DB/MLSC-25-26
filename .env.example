# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/mlsc-registration

# Session Security (REQUIRED in production)
SESSION_SECRET=your-super-secret-session-key-here-change-me
SESSION_COOKIE_SECURE=false

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Legacy Email Support (fallback)
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password

# Google Sheets Integration (choose one method)
# Method 1: Service Account JSON File Path
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account-key.json

# Method 2: Base64 Encoded JSON (alternative)
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=base64-encoded-service-account-json

# Method 3: Raw JSON (not recommended for production)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Google Sheets Configuration
GOOGLE_SHEETS_ID=your-google-sheets-id-here

# Discord Configuration
DISCORD_INVITE=https://discord.gg/your-invite-code

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secure-admin-password-change-me
