# Server Configuration
PORT=8080
NODE_ENV=production

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Session Security (REQUIRED in production)
SESSION_SECRET=your-super-secret-session-key-here-change-me
SESSION_COOKIE_SECURE=true

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=Your App Name <your-email@gmail.com>

# Google Sheets Integration (choose one method)
# Method 1: Base64 Encoded JSON (recommended for App Platform)
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=base64-encoded-service-account-json

# Method 2: Service Account JSON File Path (for droplet deployments)
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account-key.json

# Method 3: Raw JSON (not recommended for production)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Google Sheets Configuration
GOOGLE_SHEETS_ID=your-google-sheets-id-here

# Discord Configuration
DISCORD_INVITE=https://discord.gg/your-invite-code

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secure-admin-password-change-me

# Optional: Email Testing
MAIL_TEST_TO=test@example.com